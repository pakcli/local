{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2022",
		"allowJs": true,
		"noImplicitAny": false,
		"noImplicitThis": true,
		"noImplicitReturns": false,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": false,
		"strictBindCallApply": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"types": [
			"node"
		],
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2020",
			"ES2022"
		]
	},
	"include": [
		"src/**/*.ts"
	]
}
